# Termin Notifier Konfiguration
# Kopiere diese Datei zu .env und fülle die Werte aus

# Discord Webhook URL für Benachrichtigungen
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Polling-Intervall in Millisekunden (Standard: 60000 = 1 Minute)
POLL_INTERVAL_MS=60000

# Browser unsichtbar starten? (Standard: true, auf false für sichtbaren Browser)
HEADLESS=true